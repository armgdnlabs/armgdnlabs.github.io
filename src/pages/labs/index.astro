---
import Base from "../../layouts/Base.astro";
import LabsChrome from "../../components/LabsChrome.astro";
import { PRODUCTS, priceLabel } from "../../data/site";
const feat = PRODUCTS[0];
// Deterministic "waveform" so every product has its own silhouette.
const wave = (seed: string, n = 48) => Array.from({ length: n }, (_, i) => {
  let h = 0; for (const c of seed + i) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  return 18 + (h % 82);
});
---
<Base title="Labs" zone="labs" description="ARMGDN Labs: plugins, drum kits and sample packs by yondr. Free, pay what you want, or on Gumroad.">
  <LabsChrome path="/" />
  <section class="top wrap">
    <p class="kicker" data-reveal>■ yondr · sound supply · 2026</p>
    <h1 class="title" data-reveal>Build your<br />sound</h1>
    <p class="lede" data-reveal>Plugins, drum kits and sample packs made by yondr. Small things are free or pay what you want; bigger packs and plugins are on Gumroad.</p>
  </section>

  <section id="shelf" class="shelf wrap" aria-label="Shelf">
    <div class="spines" data-reveal>
      {PRODUCTS.map((p, i) => (
        <a class={`spine ${p.status === "soon" ? "spine--soon" : ""}`} href={`/labs/${p.slug}/`} style={`--h:${78 + ((i * 13) % 22)}%`}>
          <span class="spine__type">{p.type}</span>
          <span class="spine__name">{p.name}</span>
          <span class="spine__price">{p.status === "soon" ? "SOON" : priceLabel(p.price)}</span>
        </a>
      ))}
      {Array.from({ length: Math.max(0, 9 - PRODUCTS.length) }, (_, i) => (
        <span class="spine spine--empty" style={`--h:${55 + ((i * 17) % 35)}%`} aria-hidden="true"><span class="spine__name">· · ·</span></span>
      ))}
    </div>

    <article class="win" data-reveal>
      <div class="win__bar"><span>{feat.type.toUpperCase()}</span><span>01 / {String(PRODUCTS.length).padStart(2, "0")}</span></div>
      <div class="win__body">
        <h2 class="win__name">{feat.name}</h2>
        <p class="win__spec">{feat.spec}</p>
        <div class="wave" aria-hidden="true">{wave(feat.slug).map((h) => <span style={`--h:${h}%`}></span>)}</div>
        <div class="win__row">
          <button class="pbtn" data-play={""} aria-label="Play preview">▶</button>
          <a class="pbtn pbtn--wide" href={`/labs/${feat.slug}/`}>{feat.status === "soon" ? "IN THE LAB" : "GET IT"}</a>
          <a class="pbtn" href={`/labs/${feat.slug}/`} aria-label="Details">→</a>
        </div>
        <p class="win__note">{feat.blurb}</p>
      </div>
    </article>
  </section>

  <section id="pack" class="pack wrap" data-builder data-reveal>
    <div class="pack__head"><span class="pixel-h">YOUR PACK</span><span data-count>0 / 0</span></div>
    <div class="pack__meter" data-meter aria-hidden="true"></div>
    <div class="pack__picks">
      {PRODUCTS.map((p) => <button class="pick" data-pick aria-pressed="false">{p.name}<small>{p.type}</small></button>)}
    </div>
    <p class="pack__note">Pick what you want; when the kits are out, a pack of everything you picked downloads in one go.</p>
  </section>

  <section id="pricing" class="pricing wrap">
    {[
      ["FREE", "Drops and small kits. Download, no account."],
      ["PAY WHAT YOU WANT", "Full kits. Put in $0 or support the next one."],
      ["GUMROAD", "Plugins and big packs, with licence keys and updates."],
    ].map(([h, t], i) => (
      <div class="tier" data-reveal style={`transition-delay:${i * 80}ms`}>
        <span class="tier__n">0{i + 1}</span><span class="pixel-h">{h}</span><p>{t}</p>
      </div>
    ))}
  </section>
</Base>

<style>
  .top { padding: 56px 0 28px; }
  .kicker { margin: 0; font: 20px/1 var(--screen); }
  .title { margin: 14px 0 18px; font: 700 clamp(30px, 9vw, 128px)/0.88 var(--pixel); text-transform: uppercase; letter-spacing: -0.01em; }
  .lede { max-width: 560px; margin: 0; color: var(--fg-2); font: 14px/1.6 var(--mono); }

  .shelf { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 420px); gap: 18px; align-items: end; padding-top: 30px; }
  .spines { display: flex; align-items: flex-end; gap: 6px; height: 440px; border-bottom: 2px solid var(--void); }
  .spine { position: relative; flex: 1; min-width: 38px; height: var(--h); display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 10px 0 8px; background: #fffdf9; box-shadow: inset 0 0 0 2px var(--void); transition: transform 0.3s var(--spring), background 0.2s, color 0.2s; }
  .spine:hover { transform: translateY(-14px); background: var(--void); color: var(--bone); }
  .spine__type { font: 13px/1 var(--screen); writing-mode: vertical-rl; transform: rotate(180deg); opacity: 0.7; }
  .spine__name { flex: 1; display: flex; align-items: center; font: 700 clamp(13px, 1.4vw, 17px)/1 var(--pixel); writing-mode: vertical-rl; transform: rotate(180deg); text-transform: uppercase; white-space: nowrap; }
  .spine__price { font: 16px/1 var(--screen); }
  .spine--soon { background-image: repeating-linear-gradient(45deg, transparent 0 6px, #0a0a0a10 6px 8px); }
  .spine--empty { background: transparent; box-shadow: inset 0 0 0 2px #0a0a0a33; color: #0a0a0a55; pointer-events: none; }

  .win { background: #fffdf9; box-shadow: 0 0 0 2px var(--void), 8px 8px 0 var(--void); }
  .win__bar { display: flex; justify-content: space-between; padding: 8px 12px; background: var(--void); color: var(--bone); font: 16px/1 var(--screen); }
  .win__body { padding: 18px; }
  .win__name { margin: 0; font: 700 34px/1 var(--pixel); text-transform: lowercase; }
  .win__spec { margin: 6px 0 16px; font: 18px/1 var(--screen); color: var(--fg-2); }
  .wave { display: flex; align-items: center; gap: 3px; height: 120px; padding: 8px; box-shadow: inset 0 0 0 2px var(--void); }
  .wave span { flex: 1; height: var(--h); background: var(--void); }
  .win__row { display: flex; gap: 8px; margin-top: 12px; }
  .pbtn { display: grid; place-items: center; min-width: 44px; height: 40px; padding: 0 12px; box-shadow: inset 0 0 0 2px var(--void); font: 700 13px/1 var(--pixel); background: #fffdf9; }
  .pbtn--wide { flex: 1; }
  .pbtn:hover, .pbtn.on { background: var(--void); color: var(--bone); }
  .pbtn:global(.nudge) { animation: nudge 0.4s; }
  @keyframes nudge { 25% { transform: translateX(-3px); } 75% { transform: translateX(3px); } }
  .win__note { margin: 14px 0 0; font: 13px/1.5 var(--mono); color: var(--fg-2); }
  @media (max-width: 860px) { .shelf { grid-template-columns: 1fr; } .spines { height: 320px; } .spine { min-width: 0; } .spine--empty:nth-child(n+7) { display: none; } }

  .pack { margin-top: 64px; padding: 18px; background: var(--void); color: var(--bone); }
  .pack__head { display: flex; justify-content: space-between; font: 20px/1 var(--screen); }
  .pixel-h { font: 700 18px/1 var(--pixel); text-transform: uppercase; }
  .pack__meter { --fill: 0%; height: 22px; margin: 14px 0; box-shadow: inset 0 0 0 2px var(--bone); background: linear-gradient(90deg, var(--bone) var(--fill), transparent var(--fill)); background-size: 100% 100%; transition: background 0.4s; image-rendering: pixelated; }
  .pack__picks { display: flex; flex-wrap: wrap; gap: 8px; }
  .pick { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 10px 14px; box-shadow: inset 0 0 0 2px var(--bone); font: 700 13px/1 var(--pixel); text-transform: uppercase; }
  .pick small { font: 15px/1 var(--screen); text-transform: none; opacity: 0.7; }
  .pick[aria-pressed="true"] { background: var(--bone); color: var(--void); }
  .pack__note { margin: 14px 0 0; font: 13px/1.5 var(--mono); opacity: 0.7; }

  .pricing { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 64px; }
  .tier { padding: 18px; box-shadow: inset 0 0 0 2px var(--void); background: #fffdf9; }
  .tier__n { display: block; margin-bottom: 26px; font: 18px/1 var(--screen); }
  .tier p { margin: 10px 0 0; font: 13px/1.5 var(--mono); color: var(--fg-2); }
  @media (max-width: 760px) { .pricing { grid-template-columns: 1fr; } }
</style>
