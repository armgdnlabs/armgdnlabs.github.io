---
import Base from "../../layouts/Base.astro";
import ItemPage from "../../components/ItemPage.astro";
import Signup from "../../components/Signup.astro";
import { ITEMS, type Item } from "../../data/site";
export function getStaticPaths() { return ITEMS.filter((i) => i.shelf === "plugin").map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props as { item: Item };
---
<Base title={item.name} section="labs" description={`${item.name}, ${item.kind.toLowerCase()} by ARMGDN. ${item.blurb}`}>
  <ItemPage item={item} back={{ href: "/labs/#plugins", label: "Labs" }} />
  <Signup title="Get it first." line="Beta builds and launch day go to the list first." />
</Base>
