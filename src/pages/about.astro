---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { FOLLOW } from "../data/site";
const parts = [
  ["Labs", "Experimental plugins, web apps and creative tools. Monitor is the first, free and open source."],
  ["Sounds", "Drum kits and sample packs made alongside the tools, with free drops for the mailing list."],
  ["Records", "A label, later. When there is music to put out, it will live here."],
];
---
<Base title="About" section="about" description="ARMGDN makes experimental plugins, creative tools and sounds. The Chaos to Create.">
  <section class="ab wrap">
    <div data-reveal><Mark class="ab__sym" /></div>
    <h1 class="ab__title lines"><span><span>The Chaos</span></span><span><span>to Create.</span></span></h1>
    <p class="lede ab__lede" data-reveal>ARMGDN, short for Armageddon, makes experimental plugins, creative tools and the sounds that come out of them. <b>Built in-house, and as much of it as possible given away.</b></p>
    <div class="ab__parts">
      {parts.map(([h, t]) => <div class="ab__part card" data-reveal data-tilt><span class="tag">{h}</span><p>{t}</p></div>)}
    </div>
    <div id="contact" class="ab__contact" data-reveal>
      <span class="tag">Contact</span>
      <p>Find ARMGDN on {FOLLOW.map((s, i) => <>{i ? ", " : ""}<a href={s.url} rel="noopener">{s.label}</a></>)}.</p>
    </div>
  </section>
</Base>
<style>
  .ab { padding-top: 140px; }
  .ab :global(.ab__sym) { height: 76px; }
  .ab__title { margin: 36px 0; font: italic 400 clamp(60px, 11vw, 170px)/0.9 var(--serif); }
  .ab__lede { max-width: 60ch; margin-bottom: 64px; font-size: 19px; }
  .ab__parts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .ab__part { padding: 26px; min-height: 220px; transition: transform 0.25s var(--ease); }
  .ab__part p { margin: 16px 0 0; color: var(--fg-2); font: 15px/1.55 var(--grot); }
  .ab__contact { margin-top: 64px; }
  .ab__contact p { font: 17px/1.6 var(--grot); color: var(--fg-2); }
  .ab__contact a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .ab__parts { grid-template-columns: 1fr; } }
</style>
