---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { PRODUCTS, RELEASES, TOOLS } from "../data/site";
const live = TOOLS.find((t) => t.status === "live")!;
const words = ["labs", "studio", "records", "yondr", "plugins", "kits", "samples", "free tools"];
---
<Base title="ARMGDN — Labs, Studio, Records" zone="home">
  <section class="hero wrap">
    <p class="tag" data-reveal>ARMGDN // independent sound and image</p>
    <h1 class="sr">ARMGDN</h1>
    <div class="hero__mark" data-reveal><Mark kind="wordmark" class="hero__word" /></div>
    <div class="hero__row" data-reveal>
      <p class="hero__motto">The Chaos<br />to Create.</p>
      <p class="hero__lede">Plugins, kits and samples by <b>yondr</b>. Free tools for images and video. Records from a small, deliberate label. Three doors, one house.</p>
    </div>
  </section>

  <section class="doors wrap" aria-label="Sections">
    <a class="door door--labs" href="/labs/" data-reveal>
      <div class="door__chrome"><i></i><i></i><i></i><span>armgdn/labs</span></div>
      <p class="door__pixel">SOUND<br />SUPPLY</p>
      <div class="door__bars" aria-hidden="true">{Array.from({ length: 28 }, (_, i) => <span style={`--h:${20 + ((i * 37) % 70)}%`}></span>)}</div>
      <div class="door__foot"><span class="door__name">Labs</span><span class="door__n">{String(PRODUCTS.length).padStart(2, "0")} items</span></div>
      <p class="door__line">yondr plugins, kits, samples</p>
    </a>
    <a class="door door--studio" href="/studio/" data-reveal>
      <p class="door__big">Studio.<sup>(tools)</sup></p>
      <div class="door__glass"><span class="dot-live"></span> {live.name} is live</div>
      <div class="door__foot"><span class="door__name">Studio</span><span class="door__n">{String(TOOLS.length).padStart(2, "0")} tools</span></div>
      <p class="door__line">Free creative tools in the browser</p>
    </a>
    <a class="door door--records" href="/records/" data-reveal>
      <p class="door__cond">REC<br />ORDS</p>
      <div class="door__sleeve" aria-hidden="true"><span>AGDN<br />001</span></div>
      <div class="door__foot"><span class="door__name">Records</span><span class="door__n">{String(RELEASES.length).padStart(2, "0")} release</span></div>
      <p class="door__line">Releases, roster, future artists</p>
    </a>
  </section>

  <section class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => <div class="marquee__item">{words.map((w) => <><span>{w}</span><i>⊕</i></>)}</div>)}
    </div>
  </section>

  <section class="now wrap ticks">
    <p class="tag" data-reveal>Now</p>
    <div class="now__grid">
      <a href={live.url} class="now__card" data-reveal data-tilt>
        <span class="now__kind">Studio · live</span>
        <span class="now__title">{live.name}</span>
        <span class="now__line">{live.line}</span>
        <span class="btn ghost"><span class="roll"><span>Open {live.name}</span><span>Open {live.name}</span></span><span class="pip"></span></span>
      </a>
      <a href="/labs/" class="now__card" data-reveal data-tilt>
        <span class="now__kind">Labs · in the lab</span>
        <span class="now__title">First yondr kits</span>
        <span class="now__line">Drum kits, samples and a plugin are being finished. Free or pay what you want; larger packs on Gumroad.</span>
        <span class="btn ghost"><span class="roll"><span>See Labs</span><span>See Labs</span></span><span class="pip"></span></span>
      </a>
      <a href="/records/" class="now__card" data-reveal data-tilt>
        <span class="now__kind">Records · soon</span>
        <span class="now__title">{RELEASES[0].catalog}</span>
        <span class="now__line">{RELEASES[0].artist} — {RELEASES[0].title}. The first ARMGDN release.</span>
        <span class="btn ghost"><span class="roll"><span>See Records</span><span>See Records</span></span><span class="pip"></span></span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(40px, 8vw, 96px) 0 56px; }
  .hero__mark { margin: 28px 0 40px; }
  .hero :global(.hero__word) { width: 100%; height: auto; }
  .hero__row { display: grid; grid-template-columns: 1fr minmax(0, 520px); gap: 40px; align-items: end; }
  .hero__motto { margin: 0; font: italic 400 clamp(34px, 5vw, 72px)/0.98 var(--serif); }
  .hero__lede { margin: 0; color: var(--fg-2); font: 400 15px/1.6 var(--mono); }
  .hero__lede b { color: var(--fg); font-weight: 500; }
  @media (max-width: 760px) { .hero__row { grid-template-columns: 1fr; } }

  /* Three doors: each a small preview of its section; the hovered one widens. */
  .doors { display: flex; gap: 10px; height: clamp(420px, 62vh, 620px); margin-bottom: 72px; }
  .door { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; padding: 22px; overflow: hidden; border-radius: 22px; transition: flex 0.7s var(--spring), transform 0.5s var(--spring); }
  .doors:hover .door { flex: 0.8; }
  .doors .door:hover { flex: 1.6; }
  .door__foot { display: flex; justify-content: space-between; align-items: baseline; margin-top: auto; }
  .door__name { font: 600 clamp(26px, 3vw, 40px)/1 var(--grot); letter-spacing: -0.03em; }
  .door__n { font: 11px/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; }
  .door__line { margin: 8px 0 0; font: 13px/1.4 var(--mono); opacity: 0.7; }

  .door--labs { background: var(--bone); color: var(--void); border-radius: 0; box-shadow: inset 0 0 0 2px var(--void); }
  .door__chrome { display: flex; align-items: center; gap: 4px; padding-bottom: 10px; border-bottom: 2px solid var(--void); font: 13px/1 var(--screen); }
  .door__chrome i { width: 10px; height: 10px; border: 2px solid var(--void); }
  .door__chrome i:first-child { background: var(--void); }
  .door__chrome span { margin-left: 8px; }
  .door__pixel { margin: 18px 0 0; font: 700 clamp(34px, 4.6vw, 64px)/0.92 var(--pixel); }
  .door__bars { display: flex; align-items: flex-end; gap: 3px; height: 90px; margin-top: 18px; }
  .door__bars span { flex: 1; height: var(--h); background: var(--void); transition: height 0.4s var(--spring); }
  .door--labs:hover .door__bars span { height: calc(100% - var(--h) + 10%); }

  .door--studio { background: radial-gradient(120% 90% at 20% 0%, #2a2a2a, #0b0b0b 60%); box-shadow: inset 0 0 0 1px #ffffff14; }
  .door__big { margin: 0; font: 600 clamp(52px, 7vw, 108px)/0.9 var(--grot); letter-spacing: -0.055em; }
  .door__big sup { font: 500 0.22em/1 var(--grot); color: var(--signal); letter-spacing: 0; vertical-align: 2.6em; margin-left: 4px; }
  .door__glass { align-self: flex-start; margin-top: 20px; padding: 10px 16px; border-radius: 999px; background: #ffffff10; backdrop-filter: blur(20px); box-shadow: inset 0 1px 0 #ffffff21; font: 500 13px/1 var(--grot); }

  .door--records { background: #e9e6e0; color: #0d0d0d; }
  .door__cond { margin: 0; font: 800 clamp(64px, 9vw, 150px)/0.8 var(--grot); font-stretch: 62%; letter-spacing: -0.02em; }
  .door__sleeve { position: absolute; right: 22px; top: 44%; width: 34%; aspect-ratio: 1; background: #0d0d0d; color: #e9e6e0; display: grid; place-items: center; transform: rotate(4deg); transition: transform 0.6s var(--spring); box-shadow: 0 30px 40px -24px #0008; }
  .door__sleeve span { font: 800 clamp(16px, 2vw, 26px)/0.9 var(--grot); font-stretch: 62%; text-align: center; }
  .door--records:hover .door__sleeve { transform: rotate(-3deg) translateY(-8px); }
  @media (max-width: 820px) {
    .doors { flex-direction: column; height: auto; }
    .door, .doors:hover .door, .doors .door:hover { flex: none; min-height: 300px; }
    .door__sleeve { width: 30%; }
  }

  .now { padding-top: 80px; }
  .now__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 22px; }
  .now__card { display: flex; flex-direction: column; gap: 12px; padding: 24px; min-height: 280px; border-radius: 22px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); transition: transform 0.2s; background-image: radial-gradient(400px circle at var(--gx, 50%) var(--gy, 0%), #ffffff0d, transparent 60%); }
  .now__kind { font: 11px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .now__title { font: 600 34px/1 var(--grot); letter-spacing: -0.04em; }
  .now__line { color: var(--fg-2); font-size: 13px; flex: 1; }
  .now__card .btn { align-self: flex-start; }
  @media (max-width: 860px) { .now__grid { grid-template-columns: 1fr; } }
</style>
