---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Ticker from "../components/Ticker.astro";
import Signup from "../components/Signup.astro";
import { TOOLS } from "../data/site";
const monitor = TOOLS[0];
const rows = [
  { href: "/labs/", name: "Labs", sup: "experimental", line: "Plugins, web apps and tools. Monitor is live.", cursor: "Enter Labs" },
  { href: "/sounds/", name: "Sounds", sup: "kits · samples", line: "Drum kits, sample packs, bundles and free drops.", cursor: "Hear more" },
];
---
<Base title="ARMGDN — Experimental plugins, sounds and tools" section="home">
  <section class="hero">
    <canvas data-field class="hero__field"></canvas>
    <div class="hero__fade"></div>
    <div class="hero__in wrap">
      <p class="kick" data-reveal>Plugins · sounds · tools</p>
      <h1 class="sr">ARMGDN</h1>
      <div class="hero__mark lines"><span><span><Mark kind="wordmark" class="hero__word" /></span></span></div>
      <div class="hero__row">
        <p class="hero__motto lines"><span><span>The Chaos</span></span><span><span>to Create.</span></span></p>
        <div class="hero__side" data-reveal>
          <p class="lede">Experimental plugins and creative tools, plus the drums and samples made alongside them. Built in-house.</p>
          <div class="hero__btns">
            <a class="btn" href="/labs/" data-magnet><span class="roll"><span>Enter Labs</span><span>Enter Labs</span></span><span class="pip"></span></a>
            <a class="btn ghost" href="/sounds/" data-magnet><span class="roll"><span>Sounds</span><span>Sounds</span></span></a>
          </div>
        </div>
      </div>
    </div>
    <span class="hero__scroll" aria-hidden="true"><i></i></span>
  </section>

  <Ticker items={["Labs", "Plugins", "Monitor is live", "Sounds", "Drum kits", "Sample packs", "Free drops", "The Chaos to Create"]} />

  <section class="rows wrap" aria-label="ARMGDN">
    {rows.map((r) => (
      <a class="row" href={r.href} data-cursor={r.cursor}>
        <span class="row__name lines"><span><span>{r.name}.<sup>({r.sup})</sup></span></span></span>
        <span class="row__line" data-reveal>{r.line}</span>
        <span class="row__go" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>

  <section class="mon wrap">
    <div class="mon__card card" data-tilt data-reveal>
      <div class="mon__text">
        <p class="kick">Live in Labs</p>
        <h2 class="h2">{monitor.name}.<sup>(free)</sup></h2>
        <p class="lede">{monitor.line}</p>
        <a class="btn red" href={monitor.url} data-astro-reload data-magnet><span class="roll"><span>Open Monitor</span><span>Open Monitor</span></span><span class="pip"></span></a>
      </div>
      <ul class="mon__list">{monitor.features.map((f) => <li><span>+</span>{f}</li>)}</ul>
    </div>
  </section>

  <Signup />
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding: 120px 0 64px; overflow: hidden; }
  .hero__field { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.55; }
  .hero__fade { position: absolute; inset: 0; background: linear-gradient(var(--bg) 0%, transparent 30%, transparent 55%, var(--bg) 100%); }
  .hero__in { position: relative; }
  .hero__mark { margin: 26px 0 34px; }
  .hero :global(.hero__word) { width: 100%; height: auto; }
  .hero__row { display: grid; grid-template-columns: 1fr minmax(0, 440px); gap: 40px; align-items: end; }
  .hero__motto { margin: 0; font: italic 400 clamp(40px, 6vw, 92px)/0.95 var(--serif); }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .hero__scroll { position: absolute; left: 50%; bottom: 22px; width: 22px; height: 34px; margin-left: -11px; border-radius: 12px; box-shadow: inset 0 0 0 1px var(--line-2); }
  .hero__scroll i { position: absolute; left: 50%; top: 7px; width: 2px; height: 7px; margin-left: -1px; background: var(--fg); border-radius: 2px; animation: wheel 1.8s var(--ease) infinite; }
  @keyframes wheel { 0% { transform: translateY(0); opacity: 1; } 80%, 100% { transform: translateY(12px); opacity: 0; } }
  @media (max-width: 760px) { .hero__row { grid-template-columns: 1fr; } .hero__scroll { display: none; } }

  .rows { margin-top: 90px; }
  .row { position: relative; display: grid; grid-template-columns: 1fr minmax(180px, 320px) 56px; gap: 24px; align-items: center; padding: 26px 0; border-top: 1px solid var(--line); }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .row__name { font: 600 clamp(72px, 13vw, 210px)/0.86 var(--grot); letter-spacing: -0.065em; transition: transform 0.7s var(--spring); }
  .row__name sup { font: 500 0.12em/1 var(--grot); letter-spacing: 0; color: var(--signal); vertical-align: 5.2em; margin-left: 0.12em; }
  .row:hover .row__name { transform: translateX(18px); }
  .row__line { color: var(--fg-2); font: 15px/1.5 var(--grot); }
  .row__go { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--glass-2); font-size: 18px; transition: transform 0.6s var(--spring), background 0.3s, color 0.3s; }
  .row:hover .row__go { background: var(--signal); color: var(--bone); transform: rotate(45deg); }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: 10px; } .row__go { display: none; } }

  .mon { margin-top: 120px; }
  .mon__card { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; padding: clamp(26px, 5vw, 56px); transition: transform 0.25s var(--ease); }
  .mon__text { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .mon__list { list-style: none; margin: 0; padding: 0; align-self: center; }
  .mon__list li { display: flex; gap: 14px; padding: 15px 0; border-top: 1px solid var(--line); font: 500 16px/1 var(--grot); }
  .mon__list li span { color: var(--signal); }
  @media (max-width: 820px) { .mon__card { grid-template-columns: 1fr; } }
</style>
