---
import Base from "../layouts/Base.astro";
---
<Base title="Not found" zone="home">
  <section class="nf wrap">
    <p class="tag">404</p>
    <h1>Lost signal.</h1>
    <a class="btn" href="/"><span class="roll"><span>Back home</span><span>Back home</span></span><span class="pip"></span></a>
  </section>
</Base>
<style>
  .nf { padding: 120px 0; }
  h1 { margin: 20px 0 36px; font: 600 clamp(64px, 12vw, 180px)/0.86 var(--grot); letter-spacing: -0.06em; }
</style>
