---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <section class="nf wrap">
    <canvas data-field class="nf__field"></canvas>
    <p class="kick">Error 404</p>
    <h1 class="display lines"><span><span>Lost signal.</span></span></h1>
    <p class="lede">Nothing lives at this address. It may have moved.</p>
    <div class="nf__btns">
      <a class="btn" href="/labs/"><span class="roll"><span>Labs</span><span>Labs</span></span><span class="pip"></span></a>
      <a class="btn ghost" href="/sounds/"><span class="roll"><span>Sounds</span><span>Sounds</span></span></a>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; display: flex; flex-direction: column; gap: 24px; padding: 180px 0 40px; }
  .nf__field { position: absolute; inset: 60px 0 0; width: 100%; height: 100%; opacity: 0.3; z-index: -1; }
  .nf__btns { display: flex; gap: 10px; }
</style>
