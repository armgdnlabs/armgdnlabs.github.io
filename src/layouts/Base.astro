---
import "../styles/base.css";
import Mark from "../components/Mark.astro";
import { PRODUCTS, RELEASES, TOOLS } from "../data/site";

interface Props { title: string; description?: string; zone: "home" | "labs" | "studio" | "records" | "about" }
const { title, description = "ARMGDN — Labs, Studio, Records. Plugins, kits and samples by yondr; free creative tools; releases.", zone } = Astro.props;
const nav = [
  { href: "/labs/", label: "Labs", n: PRODUCTS.length, z: "labs" },
  { href: "/studio/", label: "Studio", n: TOOLS.length, z: "studio" },
  { href: "/records/", label: "Records", n: RELEASES.length, z: "records" },
];
const pageTitle = zone === "home" ? title : `${title} — ARMGDN`;
---
<!doctype html>
<html lang="en" data-zone={zone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=JetBrains+Mono:wght@400;500;700&family=Silkscreen:wght@400;700&family=Tinos&family=VT323&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="sr" href="#main">Skip to content</a>
    <header class="hdr">
      <a class="hdr__home" href="/" aria-label="ARMGDN home">
        <Mark class="hdr__sym" />
        <span class="hdr__word">ARMGDN</span>
      </a>
      <nav class="hdr__nav" aria-label="Sections">
        {nav.map((n) => (
          <a href={n.href} aria-current={zone === n.z ? "page" : undefined}>
            <span class="roll"><span>{n.label}</span><span>{n.label}</span></span><sup>{String(n.n).padStart(2, "0")}</sup>
          </a>
        ))}
      </nav>
      <a class="hdr__about" href="/about/"><span class="roll"><span>About</span><span>About</span></span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="ftr">
      <div class="wrap">
        <div class="ftr__top">
          <p class="ftr__motto">The Chaos to Create.</p>
          <div class="ftr__cols">
            <div><p class="tag">Sections</p>{nav.map((n) => <a href={n.href}>{n.label}</a>)}<a href="/about/">About</a></div>
            <div><p class="tag">Tools</p><a href="/monitor/">Monitor</a><a href="https://github.com/armgdnlabs">GitHub</a></div>
            <div><p class="tag">Sound</p><a href="/labs/">yondr kits</a><a href="/records/">Releases</a></div>
          </div>
        </div>
        <Mark kind="wordmark" class="ftr__word" />
        <div class="ftr__base"><span>© {new Date().getFullYear()} ARMGDN</span><span>Free tools · pay-what-you-want sounds</span><span>Built in-house</span></div>
      </div>
    </footer>
    <script>import "../scripts/site.ts";</script>
  </body>
</html>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 60px; padding: 0 var(--gutter); background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .hdr__home { display: inline-flex; align-items: center; gap: 10px; }
  .hdr :global(.hdr__sym) { height: 26px; transition: transform 0.5s var(--spring); }
  .hdr__home:hover :global(.hdr__sym) { transform: rotate(-8deg) scale(0.92); }
  .hdr__word { font: 400 13px/1 var(--serif); letter-spacing: 0.42em; }
  .hdr__nav { display: flex; gap: clamp(18px, 4vw, 56px); font: 500 14px/1 var(--grot); }
  .hdr__nav a { display: inline-flex; align-items: flex-start; gap: 3px; color: var(--fg-2); transition: color 0.2s; }
  .hdr__nav a:hover, .hdr__nav a[aria-current] { color: var(--fg); }
  .hdr__nav a[aria-current]::after { content: ""; width: 5px; height: 5px; margin: 4px 0 0 4px; border-radius: 50%; background: var(--signal); }
  .hdr__nav sup { font: 500 9px/1 var(--mono); color: var(--muted); }
  .hdr__about { justify-self: end; font: 500 13px/1 var(--grot); color: var(--fg-2); }
  @media (max-width: 640px) {
    .hdr { grid-template-columns: auto 1fr; }
    .hdr__word, .hdr__about { display: none; }
    .hdr__nav { justify-content: flex-end; gap: 18px; }
  }
  .ftr { margin-top: 120px; padding: 64px 0 28px; border-top: 1px solid var(--line); }
  .ftr__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 40px; }
  .ftr__motto { margin: 0; font: italic 400 clamp(28px, 4vw, 48px)/1.05 var(--serif); }
  .ftr__cols { display: flex; gap: clamp(28px, 6vw, 80px); }
  .ftr__cols div { display: flex; flex-direction: column; gap: 8px; font: 500 14px/1.4 var(--grot); }
  .ftr__cols .tag { margin: 0 0 6px; }
  .ftr__cols a { color: var(--fg-2); }
  .ftr__cols a:hover { color: var(--fg); }
  .ftr :global(.ftr__word) { width: 100%; height: auto; margin: 72px 0 24px; opacity: 0.92; }
  .ftr__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font: 11px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
</style>
